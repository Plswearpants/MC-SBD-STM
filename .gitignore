# MATLAB editor / codegen
*.asv
*.m~
*.fig
slprj/
*.slxc

# Binary data (paper movies/figs are the exception; paper .mat stay local)
*.mat
!/examples/example_data/simple_mcsbd_2d/simple_mcsbd_2d.mat
*.3ds
*.mp4
*.pptx

# Payload trees — not uploaded
/store/**
!/store/README.md
/run entrance/inputs/
/run entrance/projects/
/run entrance/Final result/
/projects/
/tests/
/session/
/artifacts/
/experimental data/
/synthetic results/
/submission/
/examples/results/
/results/
/config/
# Paper movies and plotting scripts may be uploaded; .mat freeze files
# exceed GitHub's 100 MB limit (several are >1 GB) and stay local.
!/paper/**/*.mp4
!/paper/**/*.fig

# Solver templates (code, not experiment payloads)
!/config/*.mat
!/config/legacy/**
!/core/*.mat
/config/runtime_tunables/
!/config/runtime_tunables/README.md
/config/worker_configs/

# Logs / session clutter
*.log
*_LOGfile.txt
log.txt
ALL_SLICE_RUN_DONE.txt
session*.mat
matlab_workspace.mat

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# MATLAB editor / codegen
*.asv
*.m~
*.fig
slprj/
*.slxc

# Binary data (paper movies/figs may be uploaded; paper .mat stay local)
*.mat
!/examples/example_data/simple_mcsbd_2d/simple_mcsbd_2d.mat
*.3ds
*.mp4
*.pptx

# Payload trees — not uploaded
/store/**
!/store/README.md
/run entrance/inputs/
/run entrance/projects/
/run entrance/Final result/
/projects/
/tests/
/session/
/artifacts/
/experimental data/
/synthetic results/
/submission/
/examples/results/
/results/

# Paper movies and plotting scripts may be uploaded; .mat freeze files stay local.
!/paper/**/*.mp4
!/paper/**/*.fig

# Solver .mat templates stay local (regenerated by init_sbd → default_config_settings).
# Tracked config code: config/*.m only.
/config/legacy/
/config/runtime_tunables/
/config/worker_configs/

# Reorg notes stay local; living CHANGELOG and hist_* recovery scripts stay tracked.
/historical/docs/
/historical/history/archive/
/historical/history/payload_migration_log.txt

# Logs / session clutter
*.log
*_LOGfile.txt
log.txt
ALL_SLICE_RUN_DONE.txt
session*.mat
matlab_workspace.mat

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~
